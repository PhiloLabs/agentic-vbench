actor AVBlueDoor : SwitchableDecoration
{
    Radius 36
    Height 72
    +SOLID
    +USESPECIAL
    Activation THINGSPEC_Activate
    States
    {
    Spawn:
        DBLU A -1
        Stop
    Active:
        TNT1 A 0 A_JumpIf(
            ACS_NamedExecuteWithResult("AVDoor", 1, 1, 201),
            "Open"
        )
        Goto Spawn
    Open:
        DBLU A 3
        DBLU B 3
        TNT1 A -1
        Stop
    }
}

