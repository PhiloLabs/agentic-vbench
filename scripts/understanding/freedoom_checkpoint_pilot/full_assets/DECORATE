actor AVBlueKey : CustomInventory
{
    Inventory.PickupSound ""
    Inventory.PickupMessage ""
    +INVENTORY.ALWAYSPICKUP
    States
    {
    Spawn:
        BKEY A -1
        Stop
    Pickup:
        TNT1 A 0 A_GiveInventory("BlueCard", 1)
        TNT1 A 0 ACS_NamedExecuteAlways("AVKey", 0, 1)
        Stop
    }
}

