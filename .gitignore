# Local Python venv. Recreate with `python3 -m venv .venv` + reinstall deps
# from a frozen requirements list.
.venv/

# Harbor trial outputs. Large (~20MB per trial), regenerated by re-running,
# and `agent/sessions/.claude.json` carries Anthropic OAuth tokens — never
# check these in. Surface only the aggregate `reward.json` / `result.json`
# via a separate `results/` directory when we start tracking numbers.
jobs/

# Generated dashboard. ~2.2 GB of media assets per build. Regenerated by
# `scripts/build_site_v4.py`. The HTML files at the top are small but
# inseparable from the assets; gitignore the whole tree.
site/

# Runtime logs from rollouts + scoring (TSVs, per-task JSONs, .log files).
# The v4 anchors live in source code; reproduce these by re-running.
logs/

# Raw media inputs used by build scripts (~614 MB sources, ~5 MB clips,
# ~9 MB noise pool). Regenerated by re-fetching the upstream clips noted
# in `sources/SOURCE_DIVERSITY_NOTES.md`.
sources/
clips/
noise/

# Cached judge models (DNSMOS sig_bak_ovr.onnx ~1 MB). Bundled into each
# audio task's `tests/` at build time; regenerable.
.models/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# Claude Code session state (slash-command scheduler locks, etc.).
.claude/

# Exploratory work — one subdirectory per ad-hoc experiment, often including
# scratch task dirs, scripts, and write-ups. Promoted into `scripts/` /
# `tasks/` / `docs/` only when an experiment lands. See `experiments/*/REPORT.md`
# in each subtree for what's there.
experiments/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/

# Local-only logs
*.log

# DNS denoise materials: regenerated from the upstream HF dataset by
# `scripts/generate_dns_denoise.py`. ~150KB per WAV × 600 WAVs ≈ 90MB
# total, plus they would round-trip through git as opaque binary blobs.
tasks/dns-denoise-task*/steps/solve/workdir/noisy.wav
tasks/dns-denoise-task*/steps/solve/tests/clean.wav

# VoiceBank-DEMAND materials: regenerated from JacobLinCool/VoiceBank-DEMAND-16k.
tasks/voicebank-demand-task*/steps/solve/workdir/noisy.wav
tasks/voicebank-demand-task*/steps/solve/tests/clean.wav

# DisfluencySpeech materials: regenerated from amaai-lab/DisfluencySpeech.
# WAVs are ~340KB each; transcripts are tiny but kept gitignored for
# consistency (the generator is the canonical source).
tasks/disfluency-clean-task*/steps/solve/workdir/utterance.wav

# DIV4K-50 materials: regenerated from YSZuo/DIV4K-50. HQ refs are ~24MB
# each (4096×4096 PNG); LQ inputs are ~100KB each (256×256 degraded PNG).
tasks/div4k-50-task*/steps/solve/workdir/lq.png
tasks/div4k-50-task*/steps/solve/tests/hq.png

# DAVIS 2017 materials: regenerated from the ETH 480p ZIP. ~8MB workdir
# (50 JPEG frames) + ~500KB tests (50 indexed-palette mask PNGs).
tasks/davis-vos-task*/steps/solve/workdir/frames/
tasks/davis-vos-task*/steps/solve/workdir/first_mask.png
tasks/davis-vos-task*/steps/solve/tests/gt_masks/

# GoPro deblur materials: regenerated from snah/GOPRO_Large (9.5 GB direct
# HF zip). ~30MB workdir (30 blur PNGs) + ~30MB tests (30 sharp PNGs).
tasks/gopro-deblur-task*/steps/solve/workdir/blur/
tasks/gopro-deblur-task*/steps/solve/tests/sharp/
results/
scripts/_internal/
