# Local Python venv. Recreate with `python3 -m venv .venv` + reinstall deps
# from a frozen requirements list.
.venv/

# Harbor trial outputs. Large (~20MB per trial), regenerated by re-running,
# and `agent/sessions/.claude.json` carries Anthropic OAuth tokens — never
# check these in. Surface only the aggregate `reward.json` / `result.json`
# via a separate `results/` directory when we start tracking numbers.
jobs/

# Generated dashboard. ~2.2 GB of media assets per build. Regenerated by
# `scripts/build_site_v4.py`. The HTML files at the top are small but
# inseparable from the assets; gitignore the whole tree.
site/

# Runtime logs from rollouts + scoring (TSVs, per-task JSONs, .log files).
# The v4 anchors live in source code; reproduce these by re-running.
logs/

# Raw media inputs used by build scripts (~614 MB sources, ~5 MB clips,
# ~9 MB noise pool). Regenerated by re-fetching the upstream clips noted
# in `sources/SOURCE_DIVERSITY_NOTES.md`.
sources/
clips/
noise/

# Cached judge models (DNSMOS sig_bak_ovr.onnx ~1 MB). Bundled into each
# audio task's `tests/` at build time; regenerable.
.models/

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/

# Claude Code session state (slash-command scheduler locks, etc.).
.claude/

# Exploratory work — one subdirectory per ad-hoc experiment, often including
# scratch task dirs, scripts, and write-ups. Promoted into `scripts/` /
# `tasks/` / `docs/` only when an experiment lands. See `experiments/*/REPORT.md`
# in each subtree for what's there.
experiments/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/

# Local-only logs
*.log

results/
scripts/_internal/

# Per-task media + ground-truth files. Everything lives on the public
# HF datasets `ameddserM/agentic_vbench_video_{assembly,sequencing,
# repair}` and is baked into the Docker image at build time. Keep the
# OSS repo free of GT data the agent shouldn't see and of binary
# blobs that would bloat `git clone`. Tracked task files are limited
# to: `task.toml`, `instruction.md`, `environment/Dockerfile`,
# `steps/solve/{workdir/setup.sh, tests/{test.sh, judge.py},
# solution/solve.sh}`.
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/workdir/*.mp4
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/workdir/*.wav
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/workdir/*.png
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/workdir/*.txt
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/tests/*.mp4
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/tests/*.wav
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/tests/*.png
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/tests/*.npy
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/tests/*.onnx
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/tests/*.json
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/solution/*.mp4
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/solution/*.wav
tasks/agentic_vbench_repair/exp-*-task*/steps/solve/solution/*.json
tasks/agentic_vbench_assembly/*/steps/solve/workdir/*.mp4
tasks/agentic_vbench_sequencing/*/steps/solve/workdir/*.mp4

# Understanding task media is hosted externally and baked from pinned URLs.
release-assets/**/*.mp4
tasks/agentic_vbench_understanding/*/environment/*.mp4

# The BYU task lives on its own branch and worktree; keep its files out of this one.
tasks/agentic_vbench_understanding/byu-wsu-2023-volleyball-ace-block-timeline/
