+/** AgenticVBench GT instrumentation. Returns the creation rate currently set on one emitter, or
+ *  0 when that emitter does not exist (no graphics, or this kart has no such effect).
+ *  \param type The emitter to query.
+ */
+bool KartGFX::hasEmitter(const KartGFXType type)
+{
+    return type >= 0 && type < (int)m_all_emitters.size() && m_all_emitters[type] != NULL;
+}   // hasEmitter
+
+// ----------------------------------------------------------------------------
+int KartGFX::getCreationRateInt(const KartGFXType type)
+{
+    if (!hasEmitter(type)) return -1;
+    return m_all_emitters[type]->getCreationRate();
+}   // getCreationRateInt
+
+// ----------------------------------------------------------------------------
+float KartGFX::getCreationRateFloat(const KartGFXType type)
+{
+    if (type < 0 || type >= (int)m_all_emitters.size() || !m_all_emitters[type])
+        return 0.0f;
+    return m_all_emitters[type]->getCreationRateFloat();
+}   // getCreationRateFloat
+
+// ----------------------------------------------------------------------------
 void KartGFX::setCreationRateAbsolute(KartGFXType type, float f)
 {
 #ifndef SERVER_ONLY
