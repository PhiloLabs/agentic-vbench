{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' work/run_fine.sh && sed -n '1,240p' work/run_tr.sh && sed -n '1,260p' work/diarize.py\"","aggregated_output":"#!/bin/bash\ncd /home/wenkail/agentic-vbench/media/annotation/solve\nexport OMP_NUM_THREADS=2 MKL_NUM_THREADS=2\none(){ s=$1;e=$2; ./bin/transcribe materials/session.mp4 --start $s --end $e > work/fine/${s}_${e}.txt 2>/dev/null; }\nexport -f one\nprintf \"%s\\n\" \"880 1060\" \"1060 1320\" \"1380 1620\" \"2080 2260\" \"2280 2440\" \"4680 4960\" \"5600 5760\" \"6880 7060\" \"7080 7260\" \"7300 7480\" \"7560 7860\" \"8780 8900\" \"10600 10720\" \"2520 2680\" \\\n | xargs -P 4 -I{} bash -c 'one {}'\necho FINE_DONE\n#!/bin/bash\ncd /home/wenkail/agentic-vbench/media/annotation/solve\nmkdir -p work/tr\nexport OMP_NUM_THREADS=3 MKL_NUM_THREADS=3\nrun_one() {\n  s=$1; e=$((s+300))\n  f=$(printf \"work/tr/%05d.txt\" $s)\n  if [ -s \"$f\" ]; then return; fi\n  ./bin/transcribe materials/session.mp4 --start $s --end $e > \"$f\" 2> \"$f.err\"\n}\nexport -f run_one\nseq 0 300 10500 | xargs -P 6 -I{} bash -c 'run_one {}'\necho \"TRANSCRIPTION_ALL_DONE\"\nimport numpy as np, re, sys\n\nFPS = 4.0\nH, W = 130, 70\n\na = np.memmap('work/corner_full.raw', dtype=np.uint8, mode='r')\nn = a.size // (H * W)\na = np.asarray(a[:n * H * W]).reshape(n, H, W).astype(np.float32)\nprint('frames', n, 'duration %.1f s' % (n / FPS), file=sys.stderr)\n\n\ndef band(r0, r1, c0=12, c1=58):\n    return a[:, r0:r1, c0:c1].mean(axis=(1, 2))\n\n\n# white highlight box: bright top bar AND bright bottom bar\ns1 = np.minimum(band(10, 14), band(56, 60))\ns2 = np.minimum(band(65, 69), band(111, 115))\nnp.save('work/s1.npy', s1)\nnp.save('work/s2.npy', s2)\n\nfor nm, s in (('nio(slot1)', s1), ('thatdeath(slot2)', s2)):\n    h, e = np.histogram(s, bins=25, range=(0, 255))\n    print(nm, ' '.join('%d:%d' % (int(e[i]), h[i]) for i in range(25) if h[i]), file=sys.stderr)\n\nTH = 190\nA = s1 > TH\nB = s2 > TH\nprint('A frac %.3f  B frac %.3f  both %.3f' % (A.mean(), B.mean(), (A & B).mean()), file=sys.stderr)\n\n\ndef timeline(t0, t1, binsec=1.0):\n    \"\"\"Return list of (t, aFrac, bFrac) bins.\"\"\"\n    out = []\n    t = t0\n    while t < t1:\n        i0, i1 = int(t * FPS), int((t + binsec) * FPS)\n        if i0 >= n:\n            break\n        out.append((t, A[i0:i1].mean() if i1 > i0 else 0.0,\n                    B[i0:i1].mean() if i1 > i0 else 0.0))\n        t += binsec\n    return out\n\n\ndef label(af, bf):\n    if af >= 0.25 and bf >= 0.25:\n        return 'AB'\n    if af >= 0.25:\n        return 'A '\n    if bf >= 0.25:\n        return ' B'\n    return '..'\n\n\ndef attribute(t0, t1):\n    i0, i1 = int(t0 * FPS), int(min(t1, n / FPS) * FPS)\n    if i1 <= i0:\n        return '?', 0, 0\n    af, bf = A[i0:i1].mean(), B[i0:i1].mean()\n    if af > bf * 2 and af > 0.12:\n        return 'nio', af, bf\n    if bf > af * 2 and bf > 0.12:\n        return 'thatdeath', af, bf\n    if af < 0.05 and bf < 0.05:\n        return 'silent', af, bf\n    return 'both', af, bf\n\n\nif __name__ == '__main__':\n    if len(sys.argv) >= 3:\n        t0, t1 = float(sys.argv[1]), float(sys.argv[2])\n        src = sys.argv[3] if len(sys.argv) > 3 else 'work/transcript.txt'\n        segs = []\n        for ln in open(src):\n            m = re.match(r'\\[([\\d.]+)-([\\d.]+)\\]\\s*(.*)', ln.strip())\n            if m:\n                x, y, tx = float(m.group(1)), float(m.group(2)), m.group(3)\n                if y > t0 and x < t1:\n                    segs.append((x, y, tx))\n        for x, y, tx in segs:\n            who, af, bf = attribute(x, y)\n            bins = ''.join(label(u, v).strip() or '.' for _, u, v in timeline(x, y, 0.5))\n            print('[%7.1f-%7.1f] %-9s a=%.2f b=%.2f |%s| %s' % (x, y, who, af, bf, bins, tx))\n","exit_code":0,"status":"completed"}}
