{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport subprocess, collections, statistics\nw,h,fps=140,13,5\ncmd=['ffmpeg','-hide_banner','-loglevel','error','-ss','50','-to','3090','-i','materials/final.mp4','-vf',f'crop={w}:{h}:575:7,fps={fps},format=gray','-f','rawvideo','-pix_fmt','gray','-']\np=subprocess.Popen(cmd,stdout=subprocess.PIPE)\nn=w*h; masks={'R':[],'D':[]}; i=0\nwhile True:\n b=p.stdout.read(n)\n if len(b)<n: break\n for name,(x0,x1) in {'R':(0,40),'D':(100,140)}.items():\n  mask=0; bit=0\n  for y in range(h):\n   off=y*w\n   for x in range(x0,x1):\n    if b[off+x]>150: mask |= 1<<bit\n    bit+=1\n  masks[name].append(mask)\n i+=1\np.wait()\nprint('samples',i)\nfor name,arr in masks.items():\n ds=[(arr[j]\"'^arr[j-1]).bit_count() for j in range(1,len(arr))]\n print(name,'\"'diff quantiles',statistics.quantiles(ds,n=20)[::4], 'max',max(ds))\n # modal masks per 1 sec, compare seconds; show large sustained changes\n secm=[]\n for k in range(0,len(arr),fps):\n  group=arr[k:k+fps]\n  # majority per bit\n  m=0\n  for bit in range(520):\n   if sum((v>>bit)&1 for v in group)>=3:m|=1<<bit\n  secm.append(m)\n candidates=[]\n for s in range(2,len(secm)-2):\n  before=(secm[s-2]\"'^secm[s-1]).bit_count()\n  after=(secm[s]''^secm[s+1]).bit_count()\n  change=(secm[s-1]''^secm[s]).bit_count()\n  if before<8 and after<8 and change>15:\n   candidates.append((s+50,change,before,after))\n print('\"'candidates',len(candidates),candidates)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
