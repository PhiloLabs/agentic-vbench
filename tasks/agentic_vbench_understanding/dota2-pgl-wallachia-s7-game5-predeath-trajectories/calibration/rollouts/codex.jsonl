{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport subprocess\nfor name,x in [('R',575),('D',680)]:\n    w,h,fps=34,28,5\n    cmd=['ffmpeg','-hide_banner','-loglevel','error','-i','materials/final.mp4','-vf',f'crop={w}:{h}:{x}:2,fps={fps},format=gray','-f','rawvideo','-pix_fmt','gray','-']\n    p=subprocess.Popen(cmd,stdout=subprocess.PIPE)\n    n=w*h; prev=None; peaks=[]; i=0\n    while True:\n        b=p.stdout.read(n)\n        if len(b)<n: break\n        if prev is not None:\n            d=sum(abs(a-c) for a,c in zip(b,prev))/n\n            if d>5: peaks.append((i/fps,d,sum(b)/n))\n        prev=b; i+=1\n    p.wait()\n    print(name, 'frames',i,'peaks',len(peaks))\n    # merge nearby, keep max\n    groups=[]\n    for v in peaks:\n        if not groups or v[0]-groups[-1][-1][0]>1.0: groups.append([v])\n        else: groups[-1].append(v)\n    for g in groups: print(max(g,key=lambda z:z[1]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
